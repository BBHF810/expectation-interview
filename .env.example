# Google Gemini API Configuration
# Google AI Studio (https://aistudio.google.com/) で発行したAPIキーを設定してください
GEMINI_API_KEY=

# 使用するGeminiモデル名（デフォルト: gemini-2.5-flash-lite）
# 安定版のFlash-Lite系モデルを指定してください。例: gemini-2.5-flash-lite, gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash-lite

# 最大出力トークン数（デフォルト: 200）
GEMINI_MAX_OUTPUT_TOKENS=200

# 生成温度パラメータ（デフォルト: 0.2。低いほど安定的で一貫性のある出力になります）
GEMINI_TEMPERATURE=0.2

# OpenAI API Configuration（任意・高速な質問生成およびフォールバック用）
# OpenAI Platform (https://platform.openai.com/) で発行したAPIキーを設定してください
OPENAI_API_KEY=
# 使用するOpenAIモデル名（デフォルト: gpt-4o-mini。例: gpt-4o-mini, gpt-4o）
OPENAI_MODEL=gpt-4o-mini

# VOICEVOX Configuration（任意・音声合成用）
# ローカルPCでVOICEVOXを起動している場合のURL（デフォルト: http://127.0.0.1:50021）
NEXT_PUBLIC_VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_API_URL=
VOICEVOX_API_KEY=
